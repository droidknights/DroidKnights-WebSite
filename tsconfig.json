{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": ["*"],
      "@src/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@styles/*": ["src/_styles/*"],
      "@components/*": ["src/_components/*"],
      "@hooks/*": ["src/_hooks/*"],
      "@models/*": ["src/_lib/models/*"],
      "@lib/*": ["src/_lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
