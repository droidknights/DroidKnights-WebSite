{
  "root": true,
  "extends": ["airbnb", "next/core-web-vitals", "prettier"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": [
      "warn",
      {
        "printWidth": 120,
        "plugins": ["prettier-plugin-tailwindcss"]
      }
    ],
    "react/jsx-filename-extension": [
      "error",
      { "extensions": [".jsx", ".tsx"] }
    ],
    "import/extensions": ["error", "never"],
    "import/prefer-default-export": "off",
    "no-unused-vars": "warn",
    "no-undef": "off"
  }
}
